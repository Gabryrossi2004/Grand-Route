# Copia questo file in ".env.local" e inserisci i valori veri presi da Supabase
# (Project Settings -> API, dentro il tuo progetto Supabase).
# ".env.local" non viene mai caricato su GitHub: è solo sul tuo computer/sessione.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chiave di RapidAPI per AeroDataBox (ricerca automatica voli).
# Project Settings non serve: la trovi sulla pagina dell'API su rapidapi.com,
# dopo esserti iscritto al piano gratuito. NON ha il prefisso NEXT_PUBLIC_
# perché deve restare segreta e va usata solo lato server.
AERODATABOX_API_KEY=

# Notifiche push: coppia di chiavi generata una sola volta con
# `npx web-push generate-vapid-keys`. La chiave pubblica è ok che sia
# visibile nel browser, quella privata deve restare segreta.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Segreto condiviso con la funzione del database che il cron giornaliero usa
# per leggere le partenze imminenti: deve combaciare con il valore inserito
# nella tabella app_secrets dalla migrazione 0022.
CRON_SECRET=

# Chiave API Claude (console.anthropic.com), usata per generare la bozza di
# itinerario con l'AI. NON ha il prefisso NEXT_PUBLIC_ perché deve restare
# segreta e va usata solo lato server.
ANTHROPIC_API_KEY=

# Invio del viaggio al cliente per mail (servizio Resend, resend.com).
# RESEND_API_KEY: chiave API di Resend (resend.com -> API Keys), solo lato server.
# MAIL_FROM: mittente, con un dominio verificato su Resend, es.
#   Grand Route <noreply@grandroute.it>
RESEND_API_KEY=
MAIL_FROM=
