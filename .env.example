# Copia questo file in ".env.local" e inserisci i valori veri presi da Supabase
# (Project Settings -> API, dentro il tuo progetto Supabase).
# ".env.local" non viene mai caricato su GitHub: è solo sul tuo computer/sessione.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chiave di RapidAPI per AeroDataBox (ricerca automatica voli).
# Project Settings non serve: la trovi sulla pagina dell'API su rapidapi.com,
# dopo esserti iscritto al piano gratuito. NON ha il prefisso NEXT_PUBLIC_
# perché deve restare segreta e va usata solo lato server.
AERODATABOX_API_KEY=
